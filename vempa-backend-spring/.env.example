# Copia a ".env" (para Docker) o expórtalas en tu sistema/IDE para correr local.

# --- MySQL en Filess.io ---
DB_HOST=myhbfx.h.filess.io
DB_PORT=3306
DB_USER=santiago_bellwiseam
DB_PASSWORD=cambia-esto
DB_NAME=santiago_bellwiseam

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- JWT ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRACION_MINUTOS=60

# --- BCrypt (factor de costo: 2^N iteraciones internas) ---
BCRYPT_STRENGTH=12

# --- CORS: URL de tu frontend ---
FRONTEND_URL=http://localhost:5173

# --- Admin inicial (se crea solo al arrancar, si no existe) ---
ADMIN_EMAIL=admin@vempa.com
ADMIN_PASSWORD=cambia-esto-tambien

PORT=3000
